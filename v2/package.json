{
  "name": "gtmbot2",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "esbuild --bundle --log-level=warning --target=es2023 --format=cjs --outdir=dist --platform=node src/index.ts",
    "playtest": "devvit playtest --log-runtime --show-timestamps  --debounce=1000",
    "publish": "npm run build && devvit publish",
    "watch": "tsc --watch --preserveWatchOutput & npm run build -- --watch"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "devvit": "0.14.6",
    "@devvit/web": "0.14.6",
    "esbuild": "0.28.2",
    "hono": "4.13.12",
    "@hono/node-server": "2.1.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}